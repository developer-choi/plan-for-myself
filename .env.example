# .env.local로 복사해 값을 채운다. 배포 값은 Vercel 환경변수에 둔다.

# NextAuth — `openssl rand -base64 32`로 만든다
AUTH_SECRET=
AUTH_TRUST_HOST=true

# 구글 OAuth (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres (Neon)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
