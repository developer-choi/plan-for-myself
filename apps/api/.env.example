# .env.local로 복사해 쓴다. 값을 넣을 줄만 주석을 푼다

# 서버 포트. 없으면 4000
# PORT=4000

# Postgres 주소. 없으면 apps/api/.local-db 폴더의 PGlite 로컬 DB를 쓴다. 운영 DB 주소는 넣지 않는다
# POSTGRES_URL=

# 마이그레이션(yarn db:migrate)이 쓰는 Postgres 직접 연결(pooled 아님) 주소. 로컬에는 Neon dev branch 주소를 넣는다
# POSTGRES_URL_NON_POOLING=

# true면 실행한 SQL을 콘솔에 찍는다(N+1 확인용)
# DB_QUERY_LOG=true

# 앱 토큰 서명·검증 비밀키(32바이트 이상). 웹(apps/web/.env.local)의 AUTH_SECRET과 다른 값을 둔다
AUTH_SECRET=

# Google OAuth 클라이언트 ID. Google ID 토큰의 aud를 이 값으로 검사한다. 웹(apps/web/.env.local)의 AUTH_GOOGLE_ID와 같은 값이다
AUTH_GOOGLE_ID=

# 브라우저(웹)에서 이 서버를 부를 수 있는 출처 목록(쉼표). 끝 슬래시·경로 없이 scheme://host[:port]만 적는다. 운영은 웹 도메인을 적는다
CORS_ORIGINS=http://localhost:3000
