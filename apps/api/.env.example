# .env.local로 복사해 쓴다. 값을 넣을 줄만 주석을 푼다

# 서버 포트. 없으면 4000
# PORT=4000

# Postgres 주소. 없으면 apps/api/.local-db 폴더의 PGlite 로컬 DB를 쓴다. 운영 DB 주소는 넣지 않는다
# POSTGRES_URL=

# true면 실행한 SQL을 콘솔에 찍는다(N+1 확인용)
# DB_QUERY_LOG=true

# 앱 토큰 검증 비밀키(32바이트 이상). 웹(apps/web/.env.local)의 AUTH_SECRET과 같은 값이어야 웹이 발급한 토큰이 통한다
AUTH_SECRET=
