# .env.local로 복사해 값을 채운다. 배포 값은 Vercel 환경변수에 둔다.

# NextAuth — `openssl rand -base64 32`로 만든다
AUTH_SECRET=
AUTH_TRUST_HOST=true

# 구글 OAuth (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres (Neon) — 웹 앱은 DB를 읽지 않는다. 시드(yarn db:seed)만 읽는다
# 로컬에는 Neon `dev` branch 주소를 넣는다. 운영(`main` branch) 주소를 넣지 않는다.
# 테이블 구조 변경(마이그레이션)은 서버가 맡는다(apps/api의 yarn db:migrate). migrations 폴더는 지난 기록이다.
POSTGRES_URL_NON_POOLING=

# 새 API 서버(apps/api) 주소. 로그인·게스트 발급·토큰 갱신과 데이터 요청을 이 서버가 한다. 비어 있으면 빌드가 실패한다
# 로컬: http://localhost:4000
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN=
