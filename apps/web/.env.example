# .env.local로 복사해 값을 채운다. 배포 값은 Vercel 환경변수에 둔다.

# NextAuth — `openssl rand -base64 32`로 만든다
AUTH_SECRET=
AUTH_TRUST_HOST=true

# 구글 OAuth (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres (Neon)
# 로컬에는 Neon `dev` branch 주소를 넣는다. 운영(`main` branch) 주소를 넣지 않는다.
# POSTGRES_URL은 앱이, POSTGRES_URL_NON_POOLING은 마이그레이션(yarn migrate:*)이 읽는다.
# 마이그레이션 스크립트는 .env.local을 dotenv로 읽는다(node-pg-migrate --envPath).
# 운영 DB에 적용할 때만 그 명령 앞에 운영 주소를 준다: POSTGRES_URL_NON_POOLING=<운영 직접 연결 주소> yarn migrate:up
# (dotenv는 이미 있는 환경변수를 덮어쓰지 않아 그 한 번만 운영에 걸린다)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
