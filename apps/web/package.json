{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "migrate": "node-pg-migrate --migrations-dir migrations --migration-file-language sql --database-url-var POSTGRES_URL_NON_POOLING --envPath .env.local",
    "migrate:up": "yarn migrate up",
    "migrate:down": "yarn migrate down",
    "migrate:create": "yarn migrate create",
    "db:seed": "tsx --env-file-if-exists=.env.local seed/index.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@developer-choi/design-system": "^0.4.1",
    "@plan-for-myself/shared": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.52.3",
    "@vercel/functions": "^3.9.9",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.10",
    "next": "16.1.1",
    "next-auth": "5.0.0-beta.30",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "sass": "^1.77.8",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/eslint-plugin-query": "^5.91.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^28.1.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.17"
  }
}
