node_modules
.pnp
.pnp.js

# testing
coverage

# next.js
.next/
out/

# production
build

# turborepo — AGENTS.md는 turbo 설치가 만드는 에이전트용 안내 파일이다 (MP도 무시한다)
.turbo
AGENTS.md

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — 값은 Vercel 환경변수와 .env.local에만 둔다. 키 목록은 .env.example
.env*
!.env.example

# vercel
.vercel

# IDE
.idea/

# Claude Code local settings
.claude/
GEMINI.md

# yarn install byproduct
.yarn/install-state.gz

