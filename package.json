{
  "name": "plan-for-myself",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"**/*.{scss,css}\" --max-warnings 0 --allow-empty-input",
    "stylelint:fix": "stylelint \"**/*.{scss,css}\" --fix --max-warnings 0 --allow-empty-input"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "eslint-plugin-check-file": "^3.3.1",
    "prettier": "^3.8.2",
    "stylelint": "^17.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "turbo": "^2.7.3"
  },
  "packageManager": "yarn@4.10.3"
}
